---
/**
 * Dev-only noteId lookup. Press ⌘K (Ctrl+K) anywhere, type an id or part of a
 * title, hit Enter, land on the document.
 *
 * This exists because the site's real search is Pagefind, and Pagefind cannot
 * answer this question on two counts: its index is a build artifact that does
 * not exist under `astro dev`, and notes/inbox/sources/idea are deliberately
 * kept out of that index (they are unlisted). So the one place a noteId is most
 * useful — sitting at the desk with the paper notebook open, dev server
 * running — is exactly where site search cannot help.
 *
 * The whole index is inlined as JSON rather than fetched: it is a few hundred
 * rows, it must work with no network round-trip, and shipping an endpoint would
 * mean deciding how to keep it out of the production build. Base.astro renders
 * this under `import.meta.env.DEV`, so none of it reaches a built site.
 */
import { getCollection } from 'astro:content';
import { NOTE_ID_COLLECTIONS } from '../lib/note-id';

interface Row {
  noteId: string;
  title: string;
  href: string;
  collection: string;
}

const rows: Row[] = (
  await Promise.all(
    NOTE_ID_COLLECTIONS.map(async (collection) => {
      const entries = await getCollection(collection);
      return entries.map((entry) => ({
        noteId: entry.data.noteId ?? '',
        title: entry.data.title,
        href: `/${collection}/${entry.id}/`,
        collection,
      }));
    }),
  )
).flat();

// Stamped documents first and in id order, so typing a category prefix walks
// that category's months in sequence. Unstamped ones stay reachable by title.
rows.sort(
  (a, b) =>
    Number(Boolean(b.noteId)) - Number(Boolean(a.noteId)) ||
    a.noteId.localeCompare(b.noteId) ||
    a.title.localeCompare(b.title),
);

// `</script>` inside a title would close the JSON block early.
const payload = JSON.stringify(rows).replace(/</g, '\\u003c');
---

<div id="nid" hidden>
  <div id="nid-backdrop"></div>
  <div id="nid-panel" role="dialog" aria-label="noteId 검색" aria-modal="true">
    <input
      id="nid-input"
      type="text"
      autocomplete="off"
      spellcheck="false"
      placeholder="noteId 또는 제목 (예: AI-2608)"
    />
    <ul id="nid-list"></ul>
    <div id="nid-hint">
      <span id="nid-count"></span>
      <span>↑↓ 이동 · ↵ 열기 · esc 닫기</span>
    </div>
  </div>
</div>
<script id="nid-data" type="application/json" is:inline set:html={payload}></script>

<script>
  interface Row {
    noteId: string;
    title: string;
    href: string;
    collection: string;
  }

  /**
   * Every node below is rendered by this component's own template, so a miss
   * means the markup broke, not that the page lacks a palette. Throwing keeps
   * the rest of the script narrowed to non-null without assertions.
   */
  function el<T extends HTMLElement>(id: string): T {
    const node = document.getElementById(id);
    if (!node) throw new Error(`NoteIdPalette: #${id} missing`);
    return node as T;
  }

  const root = el('nid');
  const input = el<HTMLInputElement>('nid-input');
  const list = el('nid-list');
  const count = el('nid-count');
  const rows: Row[] = JSON.parse(el('nid-data').textContent || '[]');

  let matches: Row[] = [];
  let cursor = 0;

  /**
   * Every whitespace-separated term must appear somewhere in the row. That
   * makes "ai 하네스" work without caring which field holds which term, and
   * keeps a bare "AI-2608" matching the id as a substring so a partially
   * remembered id still narrows the list.
   *
   * Every match is returned — no cap. An earlier version stopped at 30, which
   * silently hid results: scrolling to the bottom of a truncated list looks
   * exactly like reaching the end of the real one. The corpus is a few hundred
   * rows, so rebuilding the whole list per keystroke costs nothing, and the
   * count in the footer states the total either way.
   */
  function search(query: string): Row[] {
    const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
    if (terms.length === 0) return rows;
    return rows.filter((row) => {
      const haystack = `${row.noteId} ${row.title} ${row.collection} ${row.href}`.toLowerCase();
      return terms.every((t) => haystack.includes(t));
    });
  }

  function go(index: number): void {
    const row = matches[index];
    if (!row) return;
    root.hidden = true;
    window.location.href = row.href;
  }

  function render(): void {
    list.replaceChildren();
    for (const [index, row] of matches.entries()) {
      const li = document.createElement('li');
      li.className = index === cursor ? 'nid-row nid-on' : 'nid-row';
      const id = document.createElement('span');
      id.className = 'nid-id';
      id.textContent = row.noteId || '—';
      const title = document.createElement('span');
      title.className = 'nid-title';
      title.textContent = row.title;
      const where = document.createElement('span');
      where.className = 'nid-col';
      where.textContent = row.collection;
      li.append(id, title, where);
      li.addEventListener('mousedown', (event) => {
        event.preventDefault();
        go(index);
      });
      list.append(li);
    }
    list.querySelector('.nid-on')?.scrollIntoView({ block: 'nearest' });
  }

  function refresh(): void {
    matches = search(input.value);
    cursor = 0;
    count.textContent =
      matches.length === rows.length ? `${rows.length}건` : `${matches.length} / ${rows.length}건`;
    render();
  }

  function move(delta: number): void {
    if (matches.length === 0) return;
    cursor = (cursor + delta + matches.length) % matches.length;
    render();
  }

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      root.hidden = !root.hidden;
      if (!root.hidden) {
        input.value = '';
        refresh();
        input.focus();
      }
      return;
    }
    if (root.hidden) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      root.hidden = true;
    } else if (event.key === 'ArrowDown') {
      event.preventDefault();
      move(1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      move(-1);
    } else if (event.key === 'Enter') {
      event.preventDefault();
      go(cursor);
    }
  });

  input.addEventListener('input', refresh);
  el('nid-backdrop').addEventListener('mousedown', () => {
    root.hidden = true;
  });
</script>

<style is:global>
  /* Scoped by #nid rather than Astro's component scoping: the result rows are
     built in the client script, so they never receive a compile-time scope
     attribute. Dev-only, so the global selectors cost nothing in production. */
  #nid {
    position: fixed;
    inset: 0;
    z-index: 90;
  }
  #nid[hidden] {
    display: none;
  }
  #nid-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.25);
  }
  #nid-panel {
    position: absolute;
    top: 12vh;
    left: 50%;
    transform: translateX(-50%);
    width: min(38rem, calc(100vw - 2rem));
    display: flex;
    flex-direction: column;
    background: var(--color-background);
    border: 1px solid var(--color-foreground);
    font-family: var(--font-mono);
  }
  #nid-input {
    padding: 0.6rem 0.75rem;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    font-size: 14px;
    outline: none;
  }
  #nid-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 60vh;
    overflow-y: auto;
  }
  .nid-row {
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.35rem 0.75rem;
    font-size: 12px;
    cursor: pointer;
  }
  .nid-on {
    background: var(--color-surface);
  }
  .nid-id {
    color: var(--color-foreground);
    white-space: nowrap;
  }
  .nid-title {
    color: var(--color-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .nid-col {
    color: var(--color-border);
    font-size: 11px;
  }
  #nid-hint {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 11px;
  }
</style>
