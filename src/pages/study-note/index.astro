---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// Unlisted category index for /study-note (direct URL only; excluded from search
// and sitemap, shown in the footer only in dev). Categorized study notes migrated
// from `/q` logs by `/migrate`. Schema-free, so titles fall back to the first H1
// (or id). Lists only top-level entries (standalone `foo.md` or category hubs
// `foo/index.md`, both yielding id `foo`); children are reachable from their hub.
const entries = await getCollection('study-note');
const notes = entries
  .filter((entry) => !entry.id.includes('/'))
  .map((entry) => {
    const body = (entry as { body?: string }).body ?? '';
    const title = entry.data.title ?? body.match(/^#\s+(.+?)\s*$/m)?.[1] ?? entry.id;
    return { href: `/study-note/${entry.id}/`, title, description: entry.data.description };
  })
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Base title="Study notes — thnkr" description="Study notes — `/q` 로그에서 정리한 학습 노트">
  <section class="mt-2">
    <h2 class="font-medium mb-1">Study notes</h2>
    <p class="not-prose mb-6 text-sm text-muted">
      `/q` 로그에서 마이그레이션한 카테고리화된 학습 노트. 직접 URL로만 접근하며 검색·사이트맵에서
      제외됩니다.
    </p>
    {
      notes.length > 0 ? (
        <ul class="not-prose space-y-2">
          {notes.map((n) => (
            <li>
              <a href={n.href} class="underline underline-offset-2 hover:text-foreground">
                {n.title}
              </a>
              {n.description && <span class="text-sm text-muted"> — {n.description}</span>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-muted">아직 문서가 없습니다.</p>
      )
    }
  </section>
</Base>
