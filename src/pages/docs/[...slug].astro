---
import { getCollection, render } from 'astro:content';
import CopyMarkdown from '../../components/CopyMarkdown.astro';
import CopyPath from '../../components/CopyPath.astro';
import Base from '../../layouts/Base.astro';

// Free-form docs (see the `docs` collection in src/content.config.ts). Unlisted:
// excluded from search (not in SEARCHABLE_COLLECTIONS, and no data-pagefind-body
// here), sitemap, and robots. Title/description are optional in frontmatter, so
// the title falls back to the first H1, then the slug.
export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const body = (entry as { body?: string }).body ?? '';
const title = entry.data.title ?? body.match(/^#\s+(.+?)\s*$/m)?.[1] ?? entry.id;
const description = entry.data.description;
// copy-markdown fetches the generated raw.md (scripts/generate-raw-markdown.ts
// now covers docs); copy-path copies the loader-provided source path.
const mdHref = `${Astro.url.pathname.replace(/\/$/, '')}/raw.md`;
const sourcePath = entry.filePath ?? `src/content/docs/${entry.id}.md`;
---

<Base title={`${title} — thnkr`} description={description}>
  <div class="flex justify-end gap-4">
    <CopyMarkdown href={mdHref} />
    <CopyPath value={sourcePath} />
  </div>
  <article class="prose max-w-none mt-2">
    <Content />
  </article>
</Base>
