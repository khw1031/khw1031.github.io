---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

// Unlisted date TOC for /logs/questions (direct URL only; excluded from search
// and sitemap). Dated `/q` question logs. Schema-free, so the title falls back to
// the first H1 (or id) and the date is derived from a YYYY-MM-DD in the id.
const entries = await getCollection('logs');
const questions = entries
  .filter((entry) => entry.id.startsWith('questions/'))
  .map((entry) => {
    const body = (entry as { body?: string }).body ?? '';
    const title = entry.data.title ?? body.match(/^#\s+(.+?)\s*$/m)?.[1] ?? entry.id;
    const date = entry.id.match(/(\d{4}-\d{2}-\d{2})/)?.[1];
    return { href: `/logs/${entry.id}/`, title, date };
  })
  .sort((a, b) => (b.date ?? b.href).localeCompare(a.date ?? a.href));
---

<Base title="Question logs — thnkr" description="Question logs — 날짜별 `/q` 질문 로그">
  <section class="mt-2">
    <h2 class="font-medium mb-1">Question logs</h2>
    <p class="not-prose mb-6 text-sm text-muted">
      날짜별 `/q` 질문 로그. 직접 URL로만 접근하며 검색·사이트맵에서 제외됩니다.
    </p>
    {
      questions.length > 0 ? (
        <ul class="not-prose space-y-2">
          {questions.map((q) => (
            <li>
              <a href={q.href} class="underline underline-offset-2 hover:text-foreground">
                {q.title}
              </a>
              {q.date && <span class="text-sm text-muted"> · {q.date}</span>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-muted">아직 문서가 없습니다.</p>
      )
    }
  </section>
</Base>
