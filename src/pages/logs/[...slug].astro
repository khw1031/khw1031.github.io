---
import { getCollection, render } from 'astro:content';
import CopyMarkdown from '../../components/CopyMarkdown.astro';
import CopyPath from '../../components/CopyPath.astro';
import NoteAnnotator from '../../components/NoteAnnotator.astro';
import Base from '../../layouts/Base.astro';

// Free-form logs (see the `logs` collection in src/content.config.ts). Unlisted:
// excluded from search (not in SEARCHABLE_COLLECTIONS, no data-pagefind-body here),
// sitemap, and robots. Title/description are optional, so the title falls back to
// the first H1, then the id. Shows a visible title + copy-markdown/copy-path and the
// dev-only NoteAnnotator (select text → add a note), like the other document pages.
export async function getStaticPaths() {
  const entries = await getCollection('logs');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const body = (entry as { body?: string }).body ?? '';
const title = entry.data.title ?? body.match(/^#\s+(.+?)\s*$/m)?.[1] ?? entry.id;
const description = entry.data.description;
// copy-markdown fetches the generated raw.md (scripts/generate-raw-markdown.ts
// covers logs); copy-path copies the loader-provided source path. data-source-path
// is what the dev NoteAnnotator maps clicked blocks back to.
const mdHref = `${Astro.url.pathname.replace(/\/$/, '')}/raw.md`;
const sourcePath = entry.filePath ?? `src/content/logs/${entry.id}.md`;
---

<Base title={`${title} — thnkr`} description={description}>
  <div class="flex justify-end gap-4">
    <CopyMarkdown href={mdHref} />
    <CopyPath value={sourcePath} />
  </div>
  <article
    class="prose max-w-none mt-2"
    data-collection="logs"
    data-source-path={sourcePath}
    data-raw-md={mdHref}
  >
    <h1>{title}</h1>
    <Content />
  </article>
  {import.meta.env.DEV && <NoteAnnotator />}
</Base>
