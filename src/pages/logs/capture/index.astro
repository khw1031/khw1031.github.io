---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

// Unlisted date TOC for organized `/capture` conversation logs. Entries are
// final-form chronological records and are not migrated or deleted here.
const entries = await getCollection('logs');
const captures = entries
  .filter((entry) => entry.id.startsWith('capture/'))
  .map((entry) => {
    const body = (entry as { body?: string }).body ?? '';
    const title = entry.data.title ?? body.match(/^#\s+(.+?)\s*$/m)?.[1] ?? entry.id;
    const date = entry.id.match(/(\d{4}-\d{2}-\d{2})/)?.[1];
    return { href: `/logs/${entry.id}/`, title, date };
  })
  .sort((a, b) => (b.date ?? b.href).localeCompare(a.date ?? a.href));
---

<Base title="Capture logs — thnkr" description="Capture logs — 정리된 대화 기록">
  <section class="mt-2">
    <h2 class="font-medium mb-1">Capture logs</h2>
    <p class="not-prose mb-6 text-sm text-muted">
      `/capture`로 정리해 쌓은 날짜별 대화 기록입니다. 직접 URL로만 접근하며
      검색·사이트맵에서 제외됩니다.
    </p>
    {
      captures.length > 0 ? (
        <ul class="not-prose space-y-2">
          {captures.map((capture) => (
            <li>
              <a href={capture.href} class="underline underline-offset-2 hover:text-foreground">
                {capture.title}
              </a>
              {capture.date && <span class="text-sm text-muted"> · {capture.date}</span>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-muted">아직 문서가 없습니다.</p>
      )
    }
  </section>
</Base>
