---
import Base from '../../layouts/Base.astro';

// Unlisted landing for /logs (reachable by direct URL; excluded from search,
// sitemap, and shown in the footer only in dev). Questions are staging logs;
// captures are final-form chronological logs; rules are final-form logs
// organized by topic when captured.
const subIndexes = [
  { href: '/logs/capture/', label: 'capture — 정리된 대화 기록' },
  { href: '/logs/questions/', label: 'questions — 질문 로그' },
  { href: '/logs/rules/', label: 'rules — 규칙 모음' },
];
---

<Base title="Logs — thnkr" description="Logs — 정리된 대화, 질문 기록과 규칙 모음">
  <section class="mt-2">
    <h2 class="font-medium mb-1">Logs</h2>
    <p class="not-prose mb-6 text-sm text-muted">
      `/capture`로 정리한 대화 기록, `/q`로 쌓은 질문 기록과 `/r`로 확정한 규칙
      모음입니다. 직접 URL로만 접근하며 검색·사이트맵에서 제외됩니다.
    </p>
    <ul class="not-prose space-y-2">
      {
        subIndexes.map((s) => (
          <li>
            <a href={s.href} class="underline underline-offset-2 hover:text-foreground">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
