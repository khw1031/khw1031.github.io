#!/bin/sh
# Block pushes when any content .md file has incomplete/invalid frontmatter.
# This only CHECKS. To auto-fill the gaps, run the /lint skill, then push again.
#
# Enable once per clone:  git config core.hooksPath scripts/hooks

# Advisory only (never blocks): flags agent-authored notes whose body changed
# since their last /notes-polish pass. Run /notes-polish to refresh.
echo "pre-push: checking agent-authored content polish…"
npx tsx scripts/check-notes-polish.ts || true

# Advisory only (never blocks): flags kana / simplified-only characters that
# AGENTS.md §Script disallows. Replacement is a meaning choice, so it is never
# automated — rewrite the flagged lines in 한글, or allowlist a deliberate quotation.
echo "pre-push: checking for stray scripts…"
npx tsx scripts/check-stray-script.ts || true

# Advisory only (never blocks): flags captures whose body is truncated or degenerate
# — the failure mode that passes frontmatter and reads as merely "unpolished".
# Repair is a re-capture from the frontmatter's canonical, not a polish pass.
echo "pre-push: checking capture integrity…"
npx tsx scripts/check-capture-integrity.ts || true

echo "pre-push: checking content frontmatter…"
if ! npx tsx scripts/check-frontmatter.ts; then
  echo ""
  echo "pre-push blocked: fix frontmatter (run /lint to auto-fill), then push again."
  echo "To bypass intentionally: git push --no-verify"
  exit 1
fi
